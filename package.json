{
  "name": "@adobe/aem-uswds-boilerplate",
  "private": true,
  "version": "1.0.0",
  "description": "USWDS integrated with AEM Edge Delivery Services",
  "scripts": {
    "build:uswds": "node scripts/build-uswds.js",
    "build:uswds:clean": "node scripts/build-uswds.js --clean",
    "build:uswds:component": "node scripts/build-uswds.js --component=",
    "upgrade:uswds": "npm update @uswds/uswds && npm run build:uswds",
    "lint:js": "eslint . --ext .json,.js,.mjs",
    "lint:css": "stylelint 'blocks/**/*.scss' 'styles/*.scss' 'blocks/meeting-archive/*.css' 'blocks/upcoming-meetings/*.css'",
    "lint": "npm run lint:js && npm run lint:css",
    "build:json": "npm-run-all -p build:json:models build:json:definitions build:json:filters",
    "build:json:models": "merge-json-cli -i \"ue/models/component-models.json\" -o \"component-models.json\"",
    "build:json:definitions": "merge-json-cli -i \"ue/models/component-definition.json\" -o \"component-definition.json\"",
    "build:json:filters": "merge-json-cli -i \"ue/models/component-filters.json\" -o \"component-filters.json\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-block-collection.git"
  },
  "keywords": [
    "aem",
    "eds",
    "edge-delivery-services",
    "uswds",
    "design-system",
    "government",
    "accessibility",
    "wcag",
    "section-508"
  ],
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-block-collection/issues"
  },
  "homepage": "https://github.com/adobe/aem-block-collection#readme",
  "dependencies": {
    "@uswds/uswds": "^3.13.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.24.8",
    "@stylistic/stylelint-plugin": "^3.1.3",
    "autoprefixer": "^10.4.17",
    "eslint": "8.57.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-xwalk": "github:adobe-rnd/eslint-plugin-xwalk#v0.1.3",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "husky": "^9.1.7",
    "merge-json-cli": "^1.0.4",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "sass": "^1.70.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "36.0.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "^6.14.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
